{
  "imports": {
    "deno-static/": "https://cdn.jsdelivr.net/gh/garciat/deno-static@0.1.8/",
    "lume/": "https://deno.land/x/lume@v3.1.2/",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "tasks": {
    "build": "deno run --allow-all new/main.tsx",
    "serve": "deno run --allow-all --watch=./new/ new/main.tsx --dev"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:react@^19",
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
